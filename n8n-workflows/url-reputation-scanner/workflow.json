      "parameters": {
        "jsCode": "const stats    = $json.data.attributes.stats;\nconst url_info = $json.meta.url_info;\nconst normalized_url = $('Normalize Input URL').first().json.normalized_url || url_info.url;\n\nreturn [{ json: {\n  vt_malicious:   stats.malicious   || 0,\n  vt_suspicious:  stats.suspicious  || 0,\n  vt_harmless:    stats.harmless    || 0,\n  vt_undetected:  stats.undetected  || 0,\n  vt_status:      $json.data.attributes.status,\n  url:            url_info.url,\n  normalized_url: normalized_url\n}}];"
      },
