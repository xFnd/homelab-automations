      "parameters": {
        "jsCode": "let rawUrl = $input.first().json.body?.url || $input.first().json.url || '';\nrawUrl = typeof rawUrl === 'string' ? rawUrl.trim() : '';\n\nif (!rawUrl) {\n  return [{ json: { original_url: rawUrl, normalized_url: '', is_valid: false } }];\n}\n\nlet normalizedUrl = rawUrl;\nif (!/^[a-zA-Z]+:\\/\\//.test(normalizedUrl)) {\n  normalizedUrl = 'http://' + normalizedUrl;\n}\n\nlet isValid = false;\ntry {\n  const parts = normalizedUrl.split('://');\n  if (parts.length === 2) {\n    const protocol = parts[0].toLowerCase();\n    const hostPart = parts[1].split('/')[0];\n    if ((protocol === 'http' || protocol === 'https') && hostPart.length > 0 && hostPart.includes('.')) {\n      isValid = true;\n    }\n  }\n} catch (err) {\n  isValid = false;\n}\n\nreturn [{ json: { original_url: rawUrl, normalized_url: normalizedUrl, is_valid: isValid } }];"
      },
