    {
      "parameters": {
        "jsCode": "const urlscanRaw = $input.first().json;\nconst vt = $('Extract VirusTotal Verdict Stats').first().json;\n\nlet urlscan_malicious  = false;\nlet urlscan_score      = 0;\nlet urlscan_screenshot = null;\nlet urlscan_available  = false;\n\nif (!urlscanRaw.error && urlscanRaw.verdicts) {\n  urlscan_malicious  = urlscanRaw.verdicts?.overall?.malicious || false;\n  urlscan_score      = urlscanRaw.verdicts?.overall?.score     || 0;\n  urlscan_screenshot = urlscanRaw.screenshot || null;\n  urlscan_available  = true;\n}\n\nreturn [{ json: {\n  ...vt,\n  urlscan_malicious,\n  urlscan_score,\n  urlscan_screenshot,\n  urlscan_available\n}}];"
      },
      "id": "15a1ef6e-0919-4eb3-a26a-6aac50deea0d",
      "name": "Combine VT + URLScan Results",
      "type": "n8n-nodes-base.code",
      "position": [
        1120,
        432
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const malicious         = $json.vt_malicious      || 0;\nconst suspicious        = $json.vt_suspicious     || 0;\nconst harmless          = $json.vt_harmless       || 0;\nconst urlscan_malicious = $json.urlscan_malicious || false;\nconst urlscan_score     = $json.urlscan_score     || 0;\nconst urlscan_available = $json.urlscan_available || false;\n\nlet risk    = 'Low';\nlet verdict = 'SAFE';\n\nif (malicious >= 1 || urlscan_malicious) {\n  risk    = 'High';\n  verdict = 'PHISHING';\n} else if (suspicious >= 2 || urlscan_score >= 50) {\n  risk    = 'Medium';\n  verdict = 'SUSPICIOUS';\n} else if (suspicious >= 1) {\n  risk    = 'Low-Medium';\n  verdict = 'SUSPICIOUS';\n}\n\nlet displayUrl    = $json.normalized_url || $json.url || '';\nconst originalUrl = displayUrl;\n\nif (verdict !== 'SAFE') {\n  displayUrl = displayUrl\n    .replace(/^http:\\/\\//i,  'hxxp://')\n    .replace(/^https:\\/\\//i, 'hxxps://')\n    .replace(/\\./g, '[.]');\n}\n\nconst timestamp = new Date().toISOString();\n\nreturn [{ json: {\n  url:          displayUrl,\n  original_url: originalUrl,\n  verdict,\n  risk_level:   risk,\n  timestamp,\n  screenshot:   $json.urlscan_screenshot || null,\n  engines: {\n    virustotal: { malicious, suspicious, harmless },\n    urlscan:    { malicious: urlscan_malicious, score: urlscan_score, available: urlscan_available }\n  }\n}}];"
      },
