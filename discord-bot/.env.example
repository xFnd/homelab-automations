# Copie para .env e preencha. O .env NUNCA vai pro Git.

# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# ─── Canais ────────────────────────────────────────────────────────
# Discord: modo desenvolvedor → clique direito no canal → Copiar ID
SCAN_CHANNEL=
IP_CHANNEL=
PROXMOX_CHANNEL=
# Canal padrão dos alertas enviados via POST /notify (se vazio, usa o PROXMOX_CHANNEL)
ALERT_CHANNEL=

# ─── n8n ───────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678

# Servidor HTTP interno (/health e /notify)
HTTP_PORT=3001
# Chave que o n8n manda no header X-Notify-Key. Gere uma com: openssl rand -hex 32
NOTIFY_KEY=

# ─── Mídia (media.js) ──────────────────────────────────────────────
JELLYSEERR_URL=http://localhost:5055
JELLYSEERR_KEY=
# Canal dos pedidos de mídia. Quem acessa esse canal pode pedir, consultar e cancelar,
# então controle o acesso pelas permissões do canal. Se vazio, funciona em qualquer canal.
MEDIA_CHANNEL=

# Opcional: com Radarr + Sonarr, o !fila mostra progresso real e o !cancelar
# remove o torrent e desmonitora o título (sem eles, só apaga o pedido no Jellyseerr)
RADARR_URL=http://localhost:7878
RADARR_KEY=
SONARR_URL=http://localhost:8989
SONARR_KEY=
