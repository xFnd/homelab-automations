# Copie para .env e preencha. O .env NUNCA vai pro Git.

# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Canais onde cada comando é aceito (Discord: modo desenvolvedor → clique direito no canal → Copiar ID)
SCAN_CHANNEL_ID=
IP_CHANNEL_ID=
PROXMOX_CHANNEL_ID=
# Canal padrão dos alertas enviados via POST /notify (se vazio, usa o PROXMOX_CHANNEL_ID)
ALERT_CHANNEL_ID=

# Onde o n8n está rodando
N8N_BASE_URL=http://localhost:5678

# Servidor HTTP interno (/health e /notify)
HTTP_PORT=3001
# Chave que o n8n manda no header X-Notify-Key. Gere uma com: openssl rand -hex 32
NOTIFY_KEY=
