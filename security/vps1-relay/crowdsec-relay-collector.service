[Unit]
Description=crowdsec-relay: exporta alertas e estatisticas (so leitura) para o n8n de casa (HOMELAB 15.7)
After=crowdsec.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/crowdsec-relay/collect.py
Restart=always
RestartSec=30
Nice=10
MemoryMax=192M
ProtectSystem=strict
ReadWritePaths=/var/lib/crowdsec-relay
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
