#!/bin/sh
# Comando forçado da chave do n8n (authorized_keys do usuário crowdsec-relay). Só leitura.
# Verbos: alerts | stats | ping. Resposta: {"client":"<IP de origem>","data":<json>}. Ver HOMELAB §15.7.
D=/var/lib/crowdsec-relay
client=${SSH_CLIENT%% *}
# Todo comando recusado vai para o journal (auditoria: uso indevido da chave aparece em journalctl -t crowdsec-relay)
reject() {
  logger -t crowdsec-relay -p auth.warning "comando recusado de $client: $(printf '%s' "$SSH_ORIGINAL_COMMAND" | tr -cd '[:print:]' | cut -c1-200)"
  echo '{"error":"comando nao permitido"}'; exit 2
}
cmd=$SSH_ORIGINAL_COMMAND
# O nó SSH do n8n (node-ssh) manda "cd / ; <verbo>" (visto em 15/10): aceita só esse prefixo exato
case "$cmd" in "cd / ; "*) cmd=${cmd#"cd / ; "} ;; esac
case "$cmd" in
  alerts|stats) f="$D/$cmd.json" ;;
  ping) printf '{"client":"%s","data":{"pong":"%s"}}\n' "$client" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; exit 0 ;;
  *) reject ;;
esac
[ -r "$f" ] || { echo '{"error":"sem dados ainda"}'; exit 3; }
printf '{"client":"%s","data":' "$client"; cat "$f"; printf '}\n'
